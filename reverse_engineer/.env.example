# OpenAI API key (required)
OPENAI_API_KEY=sk-your-openai-api-key

# Path to the repository to analyze (required)
# The orchestrator indexes this path via index_repository before running the pipeline.
# The project name is assigned automatically by the indexer; no name is configured here.
REPO_PATH=C:/path/to/target-repository

# Final Markdown output directory (optional)
OUTPUT_DIR=C:/path/to/reverse-engineer-output

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_PROJECT=source_agent
