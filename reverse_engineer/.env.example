# OpenAI API key (required)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-api-key
LANGSMITH_PROJECT=source_agent

# NATS (optional): live progress publishing during a job.
# When integrated with asdlc-assistant, point this at their NATS instance
# using their NATS_URL / LUMOS_NATS_AUTH_TOKEN values. Left unset, the
# service runs fine -- publishing is skipped, not an error.
NATS_URL=
NATS_AUTH_TOKEN=

# Postgres (optional): direct write-back of job completion status into the
# caller's `code_analysis_jobs` table (see server/job_db.py). Left unset,
# the service runs fine -- this write is skipped, not an error. This
# service only ever UPDATEs a row created by the caller; it never INSERTs.
DATABASE_URL=


COMPACT_LLM_MODEL=
STANDARD_LLM_MODEL=
LARGE_LLM_MODEL=